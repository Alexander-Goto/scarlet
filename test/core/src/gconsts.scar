`noinline`
fn test__gconsts() {
     test(@.cli_args.type() === "core.array")
     test(@.cpu_cores_num > 0)
     test(@.env_vars.type() === "core.table")
     test(@.log_lvl__hint.type() === "core.int")
     test(@.log_lvl__important.type() === "core.int")
     test(@.log_lvl__maximum.type() === "core.int")
     test(@.log_lvl__may_require_attention.type() === "core.int")
     test(@.log_lvl__minimum.type() === "core.int")
     test(@.log_lvl__require_attention.type() === "core.int")
     test(@.log_lvl__very_important.type() === "core.int")
     test(@.pi.in_range?(3.14, 3.15))
     test(@.platform > "")
     test(@.sys_lang > "")
}